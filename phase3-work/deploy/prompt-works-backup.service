[Unit]
Description=ITK-BGSV SQLite online backup
After=prompt-works.service

[Service]
Type=oneshot
User=promptworks
Group=promptworks
WorkingDirectory=/opt/prompt-works
EnvironmentFile=/etc/prompt-works/prompt-works.env
ExecStart=/opt/prompt-works/runtime/node /opt/prompt-works/tools/backup.mjs backup /var/lib/prompt-works/game.sqlite
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/promptworks /var/lib/prompt-works
UMask=0077
LogNamespace=promptworks
