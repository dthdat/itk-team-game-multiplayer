NODE_ENV=production
HOST=127.0.0.1
PORT=3000
SQLITE_PATH=/var/lib/prompt-works/game.sqlite
ROOM_CAPACITY=80
SESSION_STARTS_PER_IP_HOUR=250
GRADING_PROVIDER=mock
PUBLIC_GAME_ORIGIN=https://game.itkvn.workers.dev
TRUSTED_PROXY_SECRET=replace-with-a-random-secret-at-least-32-characters
BACKUP_DIR=/var/backups/promptworks
BACKUP_RETENTION_DAYS=30
# Phase 3 always returns pending grading and zero XP. Live grading stays disabled.

# AI review activation requires a Free-plan organization; never upgrade billing silently.
GROQ_FREE_PLAN_CONFIRMED=false
GRADING_MIN_INTERVAL_MS=15000
GRADING_DAILY_TOKEN_CAP=100000
GRADING_MINUTE_TOKEN_CAP=8000
GRADING_DAILY_CALL_CAP=300
SUBMISSIONS_PER_IP_HOUR=1000
